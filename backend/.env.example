# Synthetic Data Platform / CLOAKDATA Backend Configuration

# LLM Provider: 'mock' (default, no API key needed), 'gemini', 'openai', or 'anthropic'
LLM_PROVIDER=mock

# API Keys (required only if not using mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Models
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Engine Defaults
DEFAULT_SEED=42
DEFAULT_LOCALE=en_US
DEFAULT_CURRENCY=USD
MAX_ROWS_PER_TABLE=100000
DEBUG=false
